<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="WhiteNoise.Views.Components.SongsList">

    <StackPanel Margin="10,10,10,10">
        <Separator Margin="10,0,10,20"/>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <TextBlock Text="N°" Grid.Column="0" HorizontalAlignment="Left" FontSize="15" FontWeight="SemiBold"/>
            <TextBlock Text="TITLE" Grid.Column="1" HorizontalAlignment="Left" FontSize="15" FontWeight="SemiBold"/>
            <TextBlock Text="ARTIST" Grid.Column="2" HorizontalAlignment="Left" FontSize="15" FontWeight="SemiBold"/>
            <TextBlock Text="ALBUM" Grid.Column="3" HorizontalAlignment="Left" FontSize="15" FontWeight="SemiBold"/>
            <TextBlock Text="YEAR" Grid.Column="4" HorizontalAlignment="Left" FontSize="15" FontWeight="SemiBold"/>
            <TextBlock Text="LENGTH" Grid.Column="5" HorizontalAlignment="Left" FontSize="15" FontWeight="SemiBold"/>
        </Grid>
        <!-- <Separator Margin="0,10,0,10"/> -->

