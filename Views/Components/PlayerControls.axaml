<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="WhiteNoise.Views.Components.PlayerControls">
    <Border BorderThickness="0" DockPanel.Dock="Left" Width="450">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">

            <Image Height="280" Width="280" Stretch="UniformToFill" Source="/Assets/USR.jpg"/>

            <TextBlock Foreground="White" Margin="0 20 0 0" TextAlignment="Center" FontSize="18" FontWeight="Bold">U Should Run</TextBlock>
            <TextBlock Foreground="White" Margin="0 6 0 0" TextAlignment="Center">Intelligency</TextBlock>
            <TextBlock Foreground="White" Margin="0 6 0 0" TextAlignment="Center">U Should Run</TextBlock>
            <Slider Classes="" x:Name="progress"/>

            <DockPanel HorizontalAlignment="Stretch" Margin="0 0 0 10">
                <TextBlock Foreground="White" DockPanel.Dock="Left" TextAlignment="Left" VerticalAlignment="Center">00:00</TextBlock>
                <TextBlock Foreground="White" DockPanel.Dock="Right" TextAlignment="Right" VerticalAlignment="Center">00:00</TextBlock>
            </DockPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Classes="rounded" Command="" Margin="0,0,10,0">
                    <PathIcon Data="{StaticResource Previous}" Width="15" Height="15"/>
                </Button>
                <Button Classes="roundedCenter" Command="" Margin="0,0,10,0" Padding="4,0,0,0" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <PathIcon Data="{StaticResource Play}"/>
                </Button>
                <Button Classes="rounded" Command="">
                    <PathIcon Data="{StaticResource Next}" Width="15" Height="15"/>
                </Button>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Content="-" Command="" Margin="0,0,10,0" />
                <Slider Classes="" x:Name="volume" Width="200" HorizontalAlignment="Center" Margin="0,0,10,0"/>
                <Button Content="+" Command="" />
            </StackPanel>

            <DockPanel HorizontalAlignment="Stretch" Margin="0 20 0 0" LastChildFill="False">
                <Button Classes="" Command="" DockPanel.Dock="Left" Width="30" Height="30" Padding="0 2 0 0">
                    <PathIcon Data="{StaticResource More}" Width="15" Height="15"/>
                </Button>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" DockPanel.Dock="Right" Spacing="5">
                    <Button Classes="" Command="" Width="30" Height="30" Padding="0 2 0 0">
                        <PathIcon Data="{StaticResource Spectre}" Width="15" Height="15"/>
                    </Button>
                    <Button Classes="" Command="" DockPanel.Dock="Right" Width="30" Height="30" Padding="0 2 0 0">
                        <PathIcon Data="{StaticResource Favourites_empty}" Width="15" Height="15"/>
                    </Button>
                </StackPanel>
            </DockPanel>

        </StackPanel>
    </Border>
</UserControl>
